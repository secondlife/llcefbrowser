#pragma once

// version of this package
#define LLCEFBROWSER_VERSION_MAJOR 1
#define LLCEFBROWSER_VERSION_MINOR @GIT_COMMIT_COUNT@
#define LLCEFBROWSER_VERSION_GITHASH "@GIT_COMMIT_HASH@"

// version numbers of CEF and Chromium pulled from CEF build via CMake
@CEF_VERSION_MAJOR_STR@
@CEF_VERSION_MINOR_STR@
@CEF_VERSION_PATCH_STR@

@CHROME_VERSION_MAJOR_STR@
@CHROME_VERSION_MINOR_STR@
@CHROME_VERSION_BUILD_STR@
@CHROME_VERSION_PATCH_STR@
